# ===========================================
# DESPACHAZAP - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# ============================================
# Frontend (Vite) Configuration
# ============================================
# API Key for proxy requests (used in vite.config.ts)
VITE_API_KEY=your-api-key-here

# API Gateway domain (used in vite.config.ts)
VITE_API_DOMAIN=your-api-gateway.execute-api.region.amazonaws.com

# ===========================================
# Backend API Configuration (for backend/server.js)
# ===========================================
# AWS API Gateway endpoint URL
AWS_API_BASE_URL=https://your-api-gateway-id.execute-api.us-east-1.amazonaws.com/production

# AWS API Gateway API Key (for authenticating with Lambda functions)
AWS_API_KEY=your-api-gateway-key-here

# ---------------------------------------------
# CORS Configuration
# ---------------------------------------------
# Comma-separated list of allowed origins for CORS
# Development: Include your local dev server
# Production: Include your production domain(s)
ALLOWED_ORIGINS=http://localhost:8080,https://yourdomain.com,https://www.yourdomain.com

# ---------------------------------------------
# Server Configuration
# ---------------------------------------------
# Port for the Express proxy server (development only)
# Default: 3001
PORT=3001

# ---------------------------------------------
# Development vs Production
# ---------------------------------------------
# In development: Express proxy server runs on PORT and adds API keys
# In production: CloudFront Functions inject API keys at the edge
# Frontend always makes requests to /api/* in both environments
